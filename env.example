# ============================================
# Next.js 前端環境變數配置
# ============================================
# 注意：Next.js 的環境變數在客戶端使用時需要以 NEXT_PUBLIC_ 開頭

# 後端 API 端點 URL
# 前端會透過此 API 端點呼叫後端服務進行 LDAP 操作
# 在 Next.js 中，API 路由位於同一個應用程式，因此可以使用相對路徑
# 範例：/api/change-password 或 http://localhost:3000/api/change-password
NEXT_PUBLIC_API_URL=/api/change-password

# ============================================
# 後端 LDAP 連線配置
# 注意：這些配置用於 Next.js API 路由（後端），不需要 NEXT_PUBLIC_ 前綴
# ============================================

# LDAP 伺服器 URL
# 範例：ldaps://ldap.example.com:636 或 ldap://ldap.example.com:389
LDAP_URL=ldaps://ldap.example.com:636

# LDAP Base DN
# 範例：dc=example,dc=com
LDAP_BASE_DN=dc=example,dc=com

# OpenLDAP Login Attribute
# 指定用來識別使用者的屬性名稱，常見的有：
# - uid: 最常用於 OpenLDAP
# - cn: 有時使用
# - mail: 使用電子郵件作為登入識別
LDAP_LOGIN_ATTRIBUTE=uid

# 使用者 DN 範本（可選）
# 如果設定了 LDAP_LOGIN_ATTRIBUTE，系統會自動構建 DN 格式為：{loginAttribute}={username},{baseDN}
# 如果需要自訂 DN 格式（例如包含 ou=users），則可以明確指定此變數
# 範例格式：
# - OpenLDAP: uid={username},ou=users,dc=example,dc=com
# - Active Directory: CN={username},CN=Users,DC=example,DC=com
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com

# SSL/TLS 憑證驗證
# 在生產環境中應該設為 true，在開發環境中使用自簽憑證時可設為 false
LDAP_REJECT_UNAUTHORIZED=true

